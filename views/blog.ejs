<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("./partials/head") %>
  <title>Blog</title>
</head>
<body>
<%- include("./partials/nav") %>
<div class="container mt-3">
<h1><%=blog.title%></h1>
<img src="<%=blog.coverImageURL%>" style="width:700px" alt="">
<pre class="mt-3"><%=blog.body%></pre>
</div>
<div class="container mt-3">
<img src="<%=blog.createdBy.profileImageURL%>" width="50px" alt=""><%=blog.createdBy.fullName%>
</div>
<div class="container mt-3">
  <h1>Comments (<%=comments.length%>)</h1>
</div>
    <%if(locals.user){%>
  <div class="container mt-3">
    <form action="/blog/comment/<%=blog._id%>" method="POST">
      <div class="mb-3">
        <input type="text" class="form-control" name="content" id="content" placeholder="Enter your comment" aria-describedby="content">
      </div>
      <button type="submit" class="btn btn-sm btn-primary">Submit</button>
    </form>
    </div>
  <%}%>
  <% comments.forEach(comment => { %>
    <div class="container mt-3">
      <img src="<%=comment.createdBy.profileImageURL%>" width="50px" alt=""><%=comment.createdBy.fullName%>
      <pre>
        <%=comment.content%>
      </pre>
    </div>
  <% }) %>
<%- include("./partials/scripts") %>
</body>
</html>